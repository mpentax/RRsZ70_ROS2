{
  "name": "rrsz70-ros2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["adapters/vendor", "apps/mcp", "apps/web", "packages/http-contracts"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node adapters/vendor/src/service-main.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "mcp:local": "node apps/mcp/src/mcp-main.ts",
    "test": "node --test adapters/vendor/src/*.test.ts apps/mcp/src/*.test.ts apps/web/tests/*.test.ts",
    "test:research": "node --test research/*.test.ts research/legacy-ts/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "mqtt": "^5.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
