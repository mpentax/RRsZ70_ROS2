# Root-context allowlist shared by deployment Dockerfiles; no private state/evidence.
**
!package.json
!package-lock.json
!tsconfig.json
!.npmrc
!THIRD_PARTY_NOTICES
!adapters/
!adapters/vendor/
!adapters/vendor/package.json
!adapters/vendor/tsconfig.json
!adapters/vendor/src/
!adapters/vendor/src/*.ts
!apps/
!apps/mcp/
!apps/mcp/package.json
!apps/mcp/tsconfig.json
!apps/mcp/src/
!apps/mcp/src/*.ts
!apps/web/
!apps/web/**
!packages/
!packages/http-contracts/
!packages/http-contracts/*.json
!packages/http-contracts/*.ts
!deploy/
!deploy/*.go
**/*.test.ts
**/node_modules/**
**/dist/**
**/.local/**
**/.env*
**/*.jpg
**/*.png
