<?xml version="1.0"?>
<package format="3">
  <name>z70_driver</name><version>0.1.0</version>
  <description>Single private vendor backend and shared observation acquisition</description>
  <maintainer email="noreply@example.com">mpentax</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>z70_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>z70_description</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
