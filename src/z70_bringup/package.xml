<?xml version="1.0"?>
<package format="3">
  <name>z70_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the Z70 ROS 2 stack</description>
  <maintainer email="noreply@example.com">mpentax</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>z70_description</exec_depend>
  <exec_depend>z70_driver</exec_depend>
  <exec_depend>z70_web_gateway</exec_depend>
  <exec_depend>z70_mapping</exec_depend>
  <exec_depend>z70_odometry</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
