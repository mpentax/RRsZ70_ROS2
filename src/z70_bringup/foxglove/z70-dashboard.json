    "3D!Robot-map-and-depth": {
      "scene": {
        "backgroundColor": "#101827",
        "meshUpAxis": "z_up",
        "transforms": {
          "visible": false,
          "editable": false,
          "showLabel": false,
          "axisSize": 0.05
        }
      },
      "layers": {
        "z70-grid": {
          "visible": true,
          "instanceId": "z70-grid",
          "layerId": "foxglove.Grid",
          "label": "Floor \u00b7 1 m grid",
          "frameId": "odom",
          "size": 10,
          "divisions": 10,
          "lineWidth": 1,
          "color": "#334155"
        },
        "z70-urdf": {
          "visible": true,
          "instanceId": "z70-urdf",
          "layerId": "foxglove.Urdf",
          "label": "Saros Z70 \u00b7 estimated arm",
          "sourceType": "topic",
          "topic": "/robot_description",
          "displayMode": "visual",
          "showOutlines": true,
          "opacity": 1
        }
      },
      "topics": {
        "/z70/odom_path": {
          "visible": true,
          "type": "line",
          "lineWidth": 0.02,
          "gradient": [
            "#38bdf8",
            "#34d399"
          ]
        },
        "/odom": {
          "visible": true,
          "type": "arrow",
          "arrowScale": [
            0.3,
            0.05,
            0.05
          ],
          "color": "#38bdf8",
          "showCovariance": false
        },
        "/map": {
          "visible": true,
          "colorMode": "map",
          "alpha": 0.7,
          "frameLocked": true
        },
        "/z70/map/safe_grid": {
          "visible": false,
          "colorMode": "map",
          "alpha": 0.4,
          "frameLocked": true
        },
        "/z70/map/dynamic_obstacles": {
          "visible": false,
          "colorMode": "map",
          "alpha": 0.5,
          "frameLocked": true
        },
        "/z70/map/markers": {
          "visible": true
        },
        "/z70/world/markers": {
          "visible": true
        },
        "/z70/garments/markers": {
          "visible": true
        },
        "/z70/objects": {
          "visible": true
        },
        "/z70/floor_mosaic": {
          "visible": false,
          "cubeOutline": false,
          "pointShape": "circle",
          "frameLocked": true,
          "cameraInfoTopic": "/z70/camera_info",
          "distance": 0.01
        },
        "/z70/floor_mosaic_mask": {
          "visible": false,
          "cubeOutline": false,
          "pointShape": "circle",
          "frameLocked": true,
          "cameraInfoTopic": "/z70/camera_info",
          "distance": 0.01
        },
        "/camera/front/depth/points": {
          "visible": true,
          "pointSize": 2,
          "cubeOutline": false,
          "pointShape": "circle",
          "colorMode": "colormap",
          "colorField": "z",
          "colorMap": "turbo",
          "minValue": 0,
          "maxValue": 2
        },
        "/z70/map/robot_pose": {
          "visible": true,
          "type": "arrow",
          "arrowScale": [
            0.3,
            0.05,
            0.05
          ],
          "color": "#fbbf24",
          "showCovariance": false
        },
        "/z70/map/dock_pose": {
          "visible": true,
          "type": "arrow",
          "arrowScale": [
            0.35,
            0.08,
            0.08
          ],
          "color": "#34d399",
          "showCovariance": false
        }
      },
      "cameraState": {
        "distance": 8.0,
        "perspective": true,
        "phi": 50,
        "target": [
          0,
          0,
          0
        ],
        "targetOffset": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "thetaOffset": 135,
        "fovy": 45,
        "near": 0.01,
        "far": 100
      },
      "followMode": "follow-none",
      "followTf": "odom",
      "fixedFrame": "map",
      "title": "Robot map and depth"
    },
