<?xml version="1.0"?>
<package format="3">
  <name>z70_mapping</name><version>0.1.0</version>
  <description>Read-only Roborock vendor LiDAR map and optional monocular depth cloud</description>
  <maintainer email="noreply@example.com">mpentax</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav_msgs</exec_depend>
